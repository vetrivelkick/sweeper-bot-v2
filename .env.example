# Sweeper Bot V2 - Environment Configuration
PRIVATE_KEY=your_polygon_private_key_here
WALLET_ADDRESS=0xYourWalletAddress
CLOB_API_KEY=your_clob_api_key
CLOB_API_SECRET=your_clob_api_secret
CLOB_API_PASSPHRASE=your_clob_api_passphrase
BUY_PRICE=0.99
LOSER_MAX_PRICE=0.005
MAX_DAILY_LOSS=50.0
GAS_FLOOR=0.5
PREFER_MAKER=true
ALLOW_TAKER_FALLBACK=false
RESTING_ORDER_TIMEOUT=120
ORDER_RECONCILE_INTERVAL=2
CANCEL_ORDERS_ON_SHUTDOWN=true
TOUCH_FILL_SECONDS=8
FILL_PROBABILITY=0.35
GHOST_PROBABILITY=0.05
PARTIAL_FILL_PROBABILITY=0.25
PARTIAL_FILL_RATIO=0.4
MAX_EVENT_EXPOSURE_USD=500
MAX_PORTFOLIO_EXPOSURE_USD=2000
MAX_429_BEFORE_TRIP=3
POLYGON_RPC=https://polygon-rpc.com

# AUDIT FIX #8: Per-market exposure limit (USD)
MAX_PER_MARKET_EXPOSURE=200.0

# AUDIT FIX #12: Structured logging
LOG_LEVEL=INFO
LOG_JSON=true
